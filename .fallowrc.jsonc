{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // oxfmt.config.ts and the example CLIs need manual entries; the rest are auto-detected.
  "entry": ["oxfmt.config.ts", "examples/*/index.ts"],
  "duplicates": {
    "minOccurrences": 3,
  },
  // Confirm dead-code candidates against the TypeScript checker so exported API
  // is never reported as unused on a name-only match.
  "typeAware": {
    "enabled": true,
  },
}
